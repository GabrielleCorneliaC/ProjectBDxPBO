<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="400.0" prefWidth="560.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.bdsqltester.scenes.adminCabang.JadwalController">
    <children>
        <fx:include fx:id="navbar" source="adminCabangNavbar.fxml" />

        <TableView fx:id="jadwalTable" layoutX="15.0" layoutY="56.0" prefHeight="259.0" prefWidth="528.0" style="-fx-background-radius: 10;">
            <columns>
                <TableColumn fx:id="jadwalNoColumn" prefWidth="40.0" text="No" />
                <TableColumn fx:id="jadwalTglColumn" prefWidth="140.0" text="Tanggal" />
                <TableColumn fx:id="jamkirimColumn" prefWidth="165.0" text="Jam Kirim" />
                <TableColumn fx:id="jamsampaiColumn" prefWidth="165.0" text="Jam Sampai" />
            </columns>
        </TableView>

        <DatePicker fx:id="tanggal" layoutX="14.0" layoutY="327.0" prefHeight="25.0" prefWidth="88.0"
                    style="-fx-background-radius: 8; -fx-border-color: #2EC4B6; -fx-border-radius: 8;" />

        <TextField fx:id="jamkirimField" layoutX="112.0" layoutY="327.0" prefHeight="25.0" prefWidth="88.0"
                   promptText="HH:mm:ss (Kirim)" style="-fx-background-radius: 8; -fx-border-color: #2EC4B6; -fx-border-radius: 8;" />

        <TextField fx:id="jamselesaiField" layoutX="210.0" layoutY="327.0" prefHeight="25.0" prefWidth="88.0"
                   promptText="HH:mm:ss (Sampai)" style="-fx-background-radius: 8; -fx-border-color: #2EC4B6; -fx-border-radius: 8;" />


        <ComboBox fx:id="pengirimanCombo" layoutX="308.0" layoutY="327.0" prefHeight="25.0" prefWidth="100.0"
                  promptText="Jenis" style="-fx-background-radius: 8; -fx-border-color: #2EC4B6; -fx-border-radius: 8;" />


        <Button fx:id="addBtn" layoutX="418.0" layoutY="327.0" mnemonicParsing="false" onAction="#addJadwal"
                style="-fx-background-color: #FF9F1C; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 10; -fx-font-family: 'Segoe UI'; -fx-cursor: hand;" text="Add" />

        <Button fx:id="updateBtn" layoutX="470.0" layoutY="327.0" mnemonicParsing="false" onAction="#updateJadwal"
                style="-fx-background-color: #FF9F1C; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 10; -fx-font-family: 'Segoe UI'; -fx-cursor: hand;" text="Update" />

        <Button fx:id="deleteBtn" layoutX="418.0" layoutY="362.0" mnemonicParsing="false" onAction="#deleteJadwal"
                style="-fx-background-color: #FF9F1C; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 10; -fx-font-family: 'Segoe UI'; -fx-cursor: hand;" text="Delete" />
    </children>
</AnchorPane>
