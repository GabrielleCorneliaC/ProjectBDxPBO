<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>

<AnchorPane prefHeight="381.0" prefWidth="528.0" style="-fx-background-color: #FFFFFF;" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.bdsqltester.scenes.adminCabang.ProcessOrderController">
    <children>

        <fx:include fx:id="navbar" source="adminCabangNavbar.fxml" />

        <TableView fx:id="transaksiTable" layoutX="14.0" layoutY="55.0" prefHeight="270.0" prefWidth="482.0" style="-fx-background-radius: 10;">
            <columns>
                <TableColumn fx:id="idColumn" prefWidth="50.0" text="ID" />
                <TableColumn fx:id="tanggalColumn" prefWidth="82.40003204345703" text="Tanggal" />
                <TableColumn fx:id="jamColumn" prefWidth="86.4000244140625" text="Jam" />
                <TableColumn fx:id="totalColumn" prefWidth="77.60003662109375" text="Total" />
                <TableColumn fx:id="pelangganColumn" prefWidth="99.199951171875" text="Pelanggan" />
                <TableColumn fx:id="statusColumn" prefWidth="86.39987182617188" text="Status" />
            </columns>
        </TableView>

        <HBox layoutX="14.0" layoutY="343.0" spacing="10.0">
            <children>
                <Button fx:id="reviewButton" disable="true" onAction="#reviewClick" style="-fx-background-color: #FF9F1C; -fx-text-fill: white; -fx-font-weight: bold;                                -fx-background-radius: 10; -fx-font-family: 'Segoe UI'; -fx-cursor: hand;" text="Lihat Review" />
                <Button fx:id="detailButton" disable="true" onAction="#detailClick" style="-fx-background-color: #FF9F1C; -fx-text-fill: white; -fx-font-weight: bold;                                -fx-background-radius: 10; -fx-font-family: 'Segoe UI'; -fx-cursor: hand;" text="Detail Order" />
                <Button fx:id="selesaiButton" disable="true" onAction="#selesaiClick" style="-fx-background-color: #FF9F1C; -fx-text-fill: white; -fx-font-weight: bold;                                -fx-background-radius: 10; -fx-font-family: 'Segoe UI'; -fx-cursor: hand;" text="Set Selesai" />
            </children>
        </HBox>
    </children>
</AnchorPane>
