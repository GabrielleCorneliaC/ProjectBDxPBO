<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>

<AnchorPane fx:id="navbar" prefHeight="60.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.bdsqltester.scenes.adminCabang.AdminNavbarController">

    <children>
        <HBox layoutY="8.0" spacing="20" style="-fx-padding: 10; -fx-alignment: center-left;">
            <children>
                <Button fx:id="menuBtn" onAction="#nextMenu" style="-fx-background-color: #FF9F1C; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 10; -fx-font-family: 'Segoe UI'; -fx-cursor: hand;" text="Menu" />
                <Button fx:id="jadwalBtn" onAction="#nextJadwal" style="-fx-background-color: #FF9F1C; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 10; -fx-font-family: 'Segoe UI'; -fx-cursor: hand;" text="Jadwal" />
                <Button fx:id="ordersBtn" onAction="#nextOrder" style="-fx-background-color: #FF9F1C; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 10; -fx-font-family: 'Segoe UI'; -fx-cursor: hand;" text="Orders" />
            </children>
        </HBox>
    </children>
</AnchorPane>
