<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ChoiceBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>

<?import javafx.scene.control.PasswordField?>
<VBox alignment="CENTER" prefWidth="320.0" spacing="20.0"
      style="-fx-background-color: #FFFFFF;"
      xmlns="http://javafx.com/javafx/23.0.1"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.bdsqltester.scenes.LoginController">

    <padding>
        <Insets top="30.0" right="30.0" bottom="30.0" left="30.0"/>
    </padding>


    <Label text="Welcome!"
           style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #2EC4B6; -fx-font-family: 'Segoe UI', 'Arial';"/>


    <GridPane hgap="10.0" vgap="10.0"
              style="-fx-background-color: #CBF3F0; -fx-background-radius: 10; -fx-padding: 20;">
        <columnConstraints>
            <ColumnConstraints prefWidth="100.0"/>
            <ColumnConstraints prefWidth="180.0"/>
        </columnConstraints>
        <rowConstraints>
            <RowConstraints prefHeight="30.0"/>
            <RowConstraints prefHeight="30.0"/>
            <RowConstraints prefHeight="30.0"/>
        </rowConstraints>
        <children>
            <Label text="Username"
                   GridPane.halignment="RIGHT"
                   style="-fx-text-fill: #2EC4B6; -fx-font-weight: bold; -fx-font-size: 13px; -fx-font-family: 'Segoe UI', 'Arial';"/>
            <TextField fx:id="usernameField" GridPane.columnIndex="1"/>

            <Label text="Password"
                   GridPane.rowIndex="1"
                   GridPane.halignment="RIGHT"
                   style="-fx-text-fill: #2EC4B6; -fx-font-weight: bold; -fx-font-size: 13px; -fx-font-family: 'Segoe UI', 'Arial';"/>
            <PasswordField fx:id="passwordField" GridPane.columnIndex="1" GridPane.rowIndex="1"/>

            <Label text="Role"
                   GridPane.rowIndex="2"
                   GridPane.halignment="RIGHT"
                   style="-fx-text-fill: #2EC4B6; -fx-font-weight: bold; -fx-font-size: 13px; -fx-font-family: 'Segoe UI', 'Arial';"/>
            <ChoiceBox fx:id="selectRole" prefWidth="150.0" GridPane.columnIndex="1" GridPane.rowIndex="2"
                       style="-fx-background-color: #2EC4B6; -fx-mark-color: white; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 13px; -fx-font-family: 'Segoe UI', 'Arial';"/>
        </children>
    </GridPane>


    <Button onAction="#onLoginClick" text="Login"
            style="-fx-background-color: #FF9F1C; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8; -fx-cursor: hand; -fx-font-family: 'Segoe UI', 'Arial';"/>
    <Button onAction="#onSignUpClick" text="Sign Up"
            style="-fx-background-color: #FFBF69; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8; -fx-cursor: hand; -fx-font-family: 'Segoe UI', 'Arial';"/>
</VBox>
