<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane prefHeight="440.0" prefWidth="443.0" style="-fx-background-color: #FFFFFF;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.bdsqltester.scenes.user.CheckoutController">

    <VBox layoutY="10.0" prefHeight="420.0" prefWidth="443.0" spacing="12" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
        <padding>
            <Insets bottom="20" left="20" right="20" top="20" />
        </padding>

        <HBox spacing="10">
            <Label prefWidth="130" style="-fx-font-weight: bold; -fx-font-family: 'Segoe UI';" text="Metode Pengiriman:" />
            <ComboBox fx:id="comboKirim" prefWidth="200" style="-fx-background-color: #2EC4B6; -fx-mark-color: white; -fx-text-fill: white;" />
        </HBox>

        <HBox spacing="10">
            <Label prefWidth="130" style="-fx-font-weight: bold; -fx-font-family: 'Segoe UI';" text="Jadwal Pengiriman:" />
            <ComboBox fx:id="comboJadwal" prefWidth="200" style="-fx-background-color: #2EC4B6; -fx-mark-color: white; -fx-text-fill: white;" />
        </HBox>

        <HBox spacing="10">
            <Label prefWidth="130" style="-fx-font-weight: bold; -fx-font-family: 'Segoe UI';" text="Metode Pembayaran:" />
            <ComboBox fx:id="comboMetodePembayaran" prefWidth="200" style="-fx-background-color: #2EC4B6; -fx-mark-color: white; -fx-text-fill: white;" />
        </HBox>

        <TableView fx:id="orderTable" prefHeight="160" style="-fx-font-family: 'Segoe UI'; -fx-font-size: 13px;">
            <columns>
                <TableColumn fx:id="itemNameColumn" prefWidth="150" text="Menu" />
                <TableColumn fx:id="quantityColumn" prefWidth="100" text="Jumlah" />
                <TableColumn fx:id="priceColumn" prefWidth="150" text="Harga" />
            </columns>
        </TableView>

        <VBox spacing="5">
            <Label fx:id="totalPriceLabel" style="-fx-font-weight: bold; -fx-text-fill: #2EC4B6; -fx-font-family: 'Segoe UI';" text="Harga: Rp 0" />
            <Label fx:id="diskonLabel" style="-fx-font-weight: bold; -fx-text-fill: #2EC4B6; -fx-font-family: 'Segoe UI';" text="Diskon: 0%" />
            <Label fx:id="totalPembayaranLabel" style="-fx-font-weight: bold; -fx-text-fill: #2EC4B6; -fx-font-size: 14px; -fx-font-family: 'Segoe UI';" text="Total Pembayaran: Rp 0" />
        </VBox>

        <HBox spacing="250" AnchorPane.bottomAnchor="10" AnchorPane.leftAnchor="10" AnchorPane.rightAnchor="10">

            <Button fx:id="cancelClick" onAction="#cancelOrder" style="-fx-background-color: #FF4C4C; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8; -fx-font-family: 'Segoe UI';" text="Cancel" />


            <Button fx:id="confirmClick" onAction="#confirmOrder" style="-fx-background-color: #FF9F1C; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8; -fx-font-family: 'Segoe UI';" text="Confirm Order" textAlignment="CENTER" HBox.hgrow="ALWAYS" />
        </HBox>

    </VBox>

</AnchorPane>
