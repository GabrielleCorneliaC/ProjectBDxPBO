<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Text?>

<AnchorPane prefHeight="500.0" prefWidth="750.0" style="-fx-background-color: linear-gradient(to bottom right, #CBF3F0, #FFFFFF);" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.bdsqltester.scenes.user.historyController">

    <VBox spacing="15" style="-fx-padding: 20; -fx-background-color: #FFFFFF; -fx-background-radius: 15; -fx-border-color: #2EC4B6; -fx-border-radius: 15;" AnchorPane.bottomAnchor="20.0" AnchorPane.leftAnchor="20.0" AnchorPane.rightAnchor="20.0" AnchorPane.topAnchor="20.0">

        <HBox alignment="CENTER_LEFT" spacing="10" style="-fx-pref-height: 40;" xmlns:fx="http://javafx.com/fxml">
            <Text style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-fill: #2EC4B6; -fx-effect: dropshadow(gaussian, #FF9F1C, 2, 0.1, 0.5, 0.5);" text="Histori Pesanan" />
            <Region fx:id="spacer" HBox.hgrow="ALWAYS" />
         <Button fx:id="btnBack1" layoutX="577.0" layoutY="13.0" onAction="#buttonBackOrderView" style="-fx-background-color: #FF9F1C; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 15; -fx-cursor: hand;" text="⟵ Order View" />
        </HBox>

        <TableView fx:id="tableHistori" prefHeight="420" style="-fx-background-radius: 10; -fx-border-radius: 10;">
            <columns>
                <TableColumn fx:id="colHistoriID" prefWidth="50" text="ID" />
                <TableColumn fx:id="colHistoriTanggal" prefWidth="150" text="Tanggal" />
                <TableColumn fx:id="colHistoriJam" prefWidth="100" text="Jam" />
                <TableColumn fx:id="colHistoriTotal" prefWidth="120" text="Total Harga" />
                <TableColumn fx:id="colHistoriStatus" prefWidth="120" text="Status" />
                <TableColumn fx:id="colHistoriRating" prefWidth="80" text="Rating" />
                <TableColumn fx:id="colHistoriReview" prefWidth="200" text="Review" />
            </columns>
        </TableView>
    </VBox>
</AnchorPane>
